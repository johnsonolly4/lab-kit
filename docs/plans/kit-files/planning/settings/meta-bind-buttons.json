{
  "note": "Meta Bind button templates the planning kit needs (Settings > Meta Bind > Button templates). Phase 4 replaces path-based actions with plugin commands.",
  "buttonTemplates": [
    {
      "label": "Update literature note",
      "hidden": false,
      "tooltip": "This will fetch new annotations from Zotero",
      "id": "update-litnote",
      "style": "primary",
      "actions": [
        {
          "type": "command",
          "command": "zotlit:update-note"
        }
      ]
    },
    {
      "label": "Today's note",
      "icon": "calendar",
      "style": "primary",
      "id": "today",
      "actions": [
        {
          "type": "command",
          "command": "daily-notes"
        }
      ]
    },
    {
      "label": "New to-do",
      "icon": "list-plus",
      "style": "default",
      "id": "todo",
      "actions": [
        {
          "type": "templaterCreateNote",
          "templateFile": "Extras/Templates/To-do.md",
          "folderPath": "00 Planning/To-dos",
          "openNote": false
        }
      ]
    },
    {
      "label": "Quick capture",
      "icon": "zap",
      "style": "default",
      "id": "capture",
      "actions": [
        {
          "type": "createNote",
          "folderPath": "00 Inbox",
          "fileName": "Capture",
          "openNote": true
        }
      ]
    },
    {
      "label": "Search",
      "icon": "search",
      "style": "default",
      "id": "search",
      "actions": [
        {
          "type": "command",
          "command": "omnisearch:show-modal"
        }
      ]
    },
    {
      "label": "Clear for tomorrow",
      "icon": "rotate-ccw",
      "style": "plain",
      "id": "clear-focus",
      "actions": [
        {
          "type": "updateMetadata",
          "bindTarget": "focus1",
          "evaluate": false,
          "value": ""
        },
        {
          "type": "updateMetadata",
          "bindTarget": "focus2",
          "evaluate": false,
          "value": ""
        },
        {
          "type": "updateMetadata",
          "bindTarget": "focus3",
          "evaluate": false,
          "value": ""
        },
        {
          "type": "updateMetadata",
          "bindTarget": "focus1_done",
          "evaluate": true,
          "value": "false"
        },
        {
          "type": "updateMetadata",
          "bindTarget": "focus2_done",
          "evaluate": true,
          "value": "false"
        },
        {
          "type": "updateMetadata",
          "bindTarget": "focus3_done",
          "evaluate": true,
          "value": "false"
        }
      ]
    },
