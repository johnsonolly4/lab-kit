    {
      "label": "Clear ticked",
      "icon": "eraser",
      "style": "plain",
      "id": "shop-clear",
      "actions": [
        {
          "type": "regexpReplaceInNote",
          "regexp": "^[ \\t]*- \\[[xX]\\] .*(\\r?\\n|$)",
          "regexpFlags": "gm",
          "replacement": ""
        }
      ]
    },
    {
      "label": "Start a new review",
      "icon": "rotate-ccw",
