{
  "schema": 2,
  "id": "planning",
  "kit": "planning-suite-kit",
  "version": "1.4.1",
  "date": "2026-10-07",
  "rewrite": {
    "00 Inbox": "inbox",
    "01 Daily Notes": "daily",
    "00 Planning": "planning",
    "02 Projects": "projects",
    "04 Literature": "literature",
    "06 Knowledge": "knowledge",
    "07 How-tos": "howtos",
    "08 Meetings": "meetings",
    "99 Archive": "archive",
    "03 Lab Book/Notes": "labNotes"
  },
  "migrations": [
    {
      "id": "knowledge-concept",
      "title": "Knowledge notes: Type: Wiki → kind: concept",
      "scope": "knowledge",
      "onlyIfMatched": true,
      "ops": [
        {
          "op": "replace-property",
          "from": "Type",
          "whenValue": "Wiki",
          "to": "kind",
          "value": "concept"
        },
        {
          "op": "add-property",
          "name": "summary",
          "value": ""
        },
        {
          "op": "add-property",
          "name": "sources",
          "value": ""
        },
        {
          "op": "add-property",
          "name": "checked",
          "value": "false"
        }
      ]
    },
    {
      "id": "move-folders",
      "title": "Move folders to the kit layout",
      "scope": "vault",
      "ops": [
        {
          "op": "move",
          "from": "Extras/Templates/Scripts",
          "to": "Extras/Templates/Actions"
        },
        {
          "op": "move",
          "from": "fonts",
          "to": "Extras/fonts"
        }
      ]
    }
  ],
  "enableCss": [
    "vault-colours.css",
    "vault-theme.css"
  ],
  "templater": {
    "userScripts": true
  },
