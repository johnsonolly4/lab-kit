filters:
  and:
    - file.inFolder("00 Planning/To-dos")
    - day != "Done"
views:
  - type: lab-kit-board
    name: Lab Kit board
    order:
      - file.name
      - done
    sort:
      - property: done
        direction: ASC
      - property: priority
        direction: ASC
  - type: kanban
    name: Board
    groupBy:
      property: day
      direction: ASC
    groupOrder:
      - Backlog
      - Mon
      - Tue
      - Wed
      - Thu
      - Fri
    columnWidth: 270
    order:
      - file.name
      - done
    sort:
      - property: done
        direction: ASC
      - property: priority
        direction: ASC
