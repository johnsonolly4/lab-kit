filters:
  and:
    - file.inFolder("03 Lab Book/Notes")
views:
  - type: kanban
    name: Experiments
    filters:
      and:
        - Status != "Closed" || file.mtime > now() - "30d"
    groupBy:
      property: Status
      direction: ASC
    groupOrder:
      - Planned
      - Started
      - Processing results
      - Closed
    sort:
      - property: file.name
        direction: DESC
    order:
      - file.name
      - progress
  - type: list
    name: All experiments
    sort:
      - property: file.name
        direction: DESC
    order:
      - file.name
      - Status
      - progress
