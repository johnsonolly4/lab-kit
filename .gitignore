# Allow-list: everything at the top level is ignored unless named below. New files inside an allowed folder
# (src/, tests/, docs/ ...) are tracked as usual. A new top-level file or folder needs a "!/name" line here, after a check that it holds nothing personal.
/*
!/.claude/
!/.github/
!/.gitignore
!/BACKLOG.md
!/CLAUDE.md
!/GETTING-STARTED.md
!/LICENSE
!/README.md
!/STATUS.md
!/docs/
!/esbuild.config.mjs
!/eslint.config.mjs
!/kits/
!/manifest.json
!/package-lock.json
!/package.json
!/scripts/
!/src/
!/styles.css
!/tests/
!/tsconfig.json
!/versions.json
!/vitest.config.mjs
!/test-vault/

# my_work/ is the owner's private folder with its own git (never pushed); it matches /* above, named here so nobody adds it
/my_work/

# build output, local settings, secrets, other OSes (anywhere inside the allowed folders)
node_modules/
main.js
*.js.map
dist/
data.json
.DS_Store
.env
*.key
Thumbs.db
CLAUDE.local.md
.claude/settings.local.json

# dev vault: only Welcome.md is tracked; hand-copied kit files, test notes, Obsidian's state and the built plugin stay local
test-vault/*
!test-vault/Welcome.md
!test-vault/.obsidian/
test-vault/.obsidian/*
!test-vault/.obsidian/.gitkeep

# generated by npm run tidy-fixture
test-vault-tidy/

# Font file for the planning kit: kept out of git until its licence is checked (docs/plans/planning-suite-kit.md, Phase 3)
docs/plans/kit-files/planning/.obsidian/snippets/vault-fonts.css
